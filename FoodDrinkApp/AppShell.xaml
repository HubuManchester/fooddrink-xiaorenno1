<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FoodDrinkApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FoodDrinkApp"
    Title="NutriBite"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}"
    Shell.ForegroundColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
    Shell.TitleColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
    Shell.UnselectedColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
    Shell.TabBarTitleColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}">

    <TabBar>
        <ShellContent
            Title="Foods"
            Icon="tab_foods.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Menu"
            Icon="tab_menu.png"
            ContentTemplate="{DataTemplate local:MenuPage}"
            Route="MenuPage" />
        <ShellContent
            Title="Hardware"
            Icon="tab_hardware.png"
            ContentTemplate="{DataTemplate local:HardwarePage}"
            Route="HardwarePage" />
        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>
</Shell>
