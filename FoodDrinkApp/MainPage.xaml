<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="NutriBite">
    <Grid RowDefinitions="Auto,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#F0F9FF, Dark=#0F172A}" Offset="0.5" />
                <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0A0F1A}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Padding="20,20,20,16">
            <Border StrokeThickness="0" Padding="24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1.2">
                        <GradientStop Color="#1E40AF" Offset="0.0" />
                        <GradientStop Color="#2563EB" Offset="0.35" />
                        <GradientStop Color="#3B82F6" Offset="0.6" />
                        <GradientStop Color="#F59E0B" Offset="0.88" />
                        <GradientStop Color="#FBBF24" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#44000000" Offset="0,12" Radius="28" Opacity="0.45" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <Label Text="NutriBite"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           CharacterSpacing="2"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Grid.Row="1"
                           Text="Track nutrition, capture photos, and explore flavours."
                           FontSize="13.5"
                           TextColor="#BFDBFE" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <Border BackgroundColor="#1AFFFFFF" Stroke="#40FFFFFF" StrokeThickness="0.8" Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="☰  Nutrition" TextColor="#FFFFFF" FontSize="11.5" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#1AFFFFFF" Stroke="#40FFFFFF" StrokeThickness="0.8" Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="◉  Camera" TextColor="#FFFFFF" FontSize="11.5" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#1AFFFFFF" Stroke="#40FFFFFF" StrokeThickness="0.8" Padding="10,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="♪  Voice" TextColor="#FFFFFF" FontSize="11.5" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                        <Border StrokeThickness="1.5"
                                Stroke="#60A5FA"
                                BackgroundColor="#FFFFFF"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <SearchBar x:Name="SearchFoodBar"
                                       Placeholder="Search foods, drinks, categories..."
                                       TextChanged="OnSearchTextChanged"
                                       SearchButtonPressed="OnSearchButtonPressed"
                                       TextColor="#1E293B"
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       SemanticProperties.Hint="Search the food and drink list" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="+  Add"
                                Padding="16,0"
                                BackgroundColor="#FBBF24"
                                TextColor="#1E293B"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="14"
                                Clicked="OnAddClicked"
                                SemanticProperties.Hint="Add a new food or drink record" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching food or drink records found."
                            Margin="18,0,18,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="1.2"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                                Padding="0"
                                Margin="0,0,0,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,6" Radius="16" Opacity="0.3" />
                            </Border.Shadow>
                            <Grid RowDefinitions="160,*">
                                <Grid IsClippedToBounds="True" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageTapped"
                                                                CommandParameter="{Binding Id}" />
                                    </Grid.GestureRecognizers>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           SemanticProperties.Description="Food photo"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                                    <Border StrokeThickness="0" HeightRequest="100" HorizontalOptions="Fill" VerticalOptions="End">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#CC000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Padding="14,12" VerticalOptions="End">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontSize="19"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFFFFF"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"
                                                       SemanticProperties.HeadingLevel="Level2" />
                                                <Label Text="{Binding Category}"
                                                       FontSize="13"
                                                       TextColor="#FCD34D"
                                                       FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#FBBF24"
                                                    Padding="12,7"
                                                    VerticalOptions="End">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding CaloriesLabel}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#1E293B" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" Padding="16,14">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8"
                                          ColumnDefinitions="*,*">
                                        <Label Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               FontSize="13.5"
                                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Border Grid.Row="1"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A5F}"
                                                Padding="10,7">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding MacroSummary}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#3A2A10}"
                                                Padding="10,7">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding AllergyNote}"
                                                   FontSize="11.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Border>
                                        <Button Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Text="View Full Details"
                                                Padding="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                CornerRadius="12"
                                                HeightRequest="42"
                                                BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                                TextColor="#FFFFFF"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnDetailsClicked"
                                                SemanticProperties.Hint="Open nutrition details" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
