<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="NutriBite">
    <Grid RowDefinitions="Auto,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF1DA, Dark=#130F0C}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFF9EF, Dark=#0F1711}" Offset="0.5" />
                <GradientStop Color="{AppThemeBinding Light=#F7EFE3, Dark=#0E1511}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Padding="20,20,20,16">
            <Border StrokeThickness="0" Padding="20,22" HeightRequest="210">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D9472B" Offset="0.0" />
                        <GradientStop Color="#E86A33" Offset="0.45" />
                        <GradientStop Color="#FF37FF00" Offset="0.75" />
                        <GradientStop Color="#3D8B5F" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#44000000" Offset="0,10" Radius="24" Opacity="0.5" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Label Text="NutriBite"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Grid.Row="1"
                           Text="Track nutrition, capture photos, and explore flavours."
                           FontSize="15"
                           TextColor="#FFF0D8" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                        <Border BackgroundColor="#28FFFFFF" StrokeThickness="0" Padding="12,9">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Nutrition" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#28FFFFFF" StrokeThickness="0" Padding="12,9">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Camera" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#28FFFFFF" StrokeThickness="0" Padding="12,9">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="Voice" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,8,0,0">
                        <Border StrokeThickness="1.5"
                                Stroke="#FFE0BA"
                                BackgroundColor="#FFFFFA"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <SearchBar x:Name="SearchFoodBar"
                                       Placeholder="Search foods, drinks, categories..."
                                       TextChanged="OnSearchTextChanged"
                                       SearchButtonPressed="OnSearchButtonPressed"
                                       TextColor="#3A2518"
                                       PlaceholderColor="#9A7B63"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       SemanticProperties.Hint="Search the food and drink list" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="+  Add"
                                Padding="16,0"
                                BackgroundColor="#2E7A4F"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="14"
                                Clicked="OnAddClicked"
                                SemanticProperties.Hint="Add a new food or drink record" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching food or drink records found."
                            Margin="18,0,18,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="1.2"
                                Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                                Padding="0"
                                Margin="0,0,0,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1A000000" Offset="0,6" Radius="16" Opacity="0.3" />
                            </Border.Shadow>
                            <Grid RowDefinitions="160,*">
                                <Grid IsClippedToBounds="True" BackgroundColor="{AppThemeBinding Light=#F5EDE0, Dark=#252015}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnImageTapped"
                                                                CommandParameter="{Binding Id}" />
                                    </Grid.GestureRecognizers>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           SemanticProperties.Description="Food photo"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill" />
                                    <Border StrokeThickness="0" HeightRequest="100" HorizontalOptions="Fill" VerticalOptions="End">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.3" />
                                                <GradientStop Color="#CC000000" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="End">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontSize="19"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFFFFF"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"
                                                       SemanticProperties.HeadingLevel="Level2" />
                                                <Label Text="{Binding Category}"
                                                       FontSize="13"
                                                       TextColor="#FFDDB5"
                                                       FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#D9472B"
                                                    Padding="12,7"
                                                    VerticalOptions="End">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding CaloriesLabel}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                <Grid Grid.Row="1" Padding="16,14">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8"
                                          ColumnDefinitions="*,*">
                                        <Label Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               FontSize="13.5"
                                               TextColor="{AppThemeBinding Light=#6E5A47, Dark=#D8C4AC}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                        <Border Grid.Row="1"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#EDF5EE, Dark=#1A2E20}"
                                                Padding="10,7">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding MacroSummary}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#2E7A4F, Dark=#7DD99A}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light=#FFF0C9, Dark=#3A2810}"
                                                Padding="10,7">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding AllergyNote}"
                                                   FontSize="11.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#A95517, Dark=#FFD18E}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </Border>
                                        <Button Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Text="View Full Details"
                                                Padding="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                CornerRadius="12"
                                                HeightRequest="42"
                                                BackgroundColor="{AppThemeBinding Light=#D9472B, Dark=#FF7D55}"
                                                TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A0A02}"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnDetailsClicked"
                                                SemanticProperties.Hint="Open nutrition details" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
