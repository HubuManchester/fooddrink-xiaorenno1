<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0A0F1A}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="20" Spacing="16">

            <Border StrokeThickness="0" Padding="20,18" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#18000000" Offset="0,6" Radius="14" Opacity="0.3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Settings"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Customise appearance and accessibility options."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1.2"
                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">

                    <Label Text="Appearance"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Theme mode"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                            <Label Text="Choose your preferred colour scheme."
                                   FontSize="12.5"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                        <Picker x:Name="ThemePicker"
                                 Grid.Column="1"
                                 Title="Choose app theme"
                                 WidthRequest="150"
                                 SelectedIndexChanged="OnThemeChanged"
                                 SemanticProperties.Hint="Switch between system, light, and dark theme">
                            <Picker.Items>
                                <x:String>System</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Large text mode"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                            <Label Text="Increase text size for better readability."
                                   FontSize="12.5"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        </VerticalStackLayout>
                        <Switch x:Name="LargeTextSwitch"
                                Grid.Column="1"
                                OnColor="#2563EB"
                                Toggled="OnLargeTextToggled"
                                SemanticProperties.Hint="Increase text size across the current session" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#3A2A10}"
                    Padding="18,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Preview: Large text mode is off"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="Toggle the switch above to see this text grow larger. The change applies to all pages in the app."
                           FontSize="14.5"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A5F}"
                    Padding="16,13">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label x:Name="SettingsStatusLabel"
                       Text="Settings ready."
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
