<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#FFF1DA, Dark=#130F0C}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#FFF9EF, Dark=#0F1711}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <Grid RowDefinitions="260,*">
            <Border StrokeThickness="0" Grid.Row="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,28,28" />
                </Border.StrokeShape>
                <Grid IsClippedToBounds="True">
                    <Image x:Name="HeroImage"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Large food photo"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                    <Border StrokeThickness="0" HeightRequest="160" HorizontalOptions="Fill" VerticalOptions="End">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#CC000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Padding="20,18" VerticalOptions="End">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="NameLabel"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       SemanticProperties.HeadingLevel="Level1" />
                                <Label x:Name="CategoryLabel"
                                       FontSize="14"
                                       TextColor="#FFDDB5" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#D9472B"
                                    Padding="14,9"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="CaloriesLabel"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1" Padding="20,16" Spacing="16">

                <Border StrokeThickness="1.2"
                        Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                        Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Text="Nutrition breakdown"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#D9472B, Dark=#FF9C7B}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E8F5EA, Dark=#162E1C}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Protein}"
                                           TextColor="{AppThemeBinding Light=#2E7A4F, Dark=#6DD98A}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#5A9C72, Dark=#7DD99A}"
                                           Text="Protein (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFF3DC, Dark=#3A2510}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Carbs}"
                                           TextColor="{AppThemeBinding Light=#B07515, Dark=#FFCF70}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#C99A40, Dark=#E8B050}"
                                           Text="Carbs (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFE8E0, Dark=#3A1812}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Fat}"
                                           TextColor="{AppThemeBinding Light=#C4451A, Dark=#FF8060}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#D48055, Dark=#FF9070}"
                                           Text="Fat (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border StrokeThickness="1.2"
                        Stroke="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                        Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Label Text="About this item"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#D9472B, Dark=#FF9C7B}" />
                        <Label x:Name="DescriptionLabel"
                               Grid.Row="1"
                               FontSize="14.5"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#5A4838, Dark=#D0BCA4}" />
                        <Border Grid.Row="2"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FFF0C9, Dark=#352510}"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border StrokeThickness="0"
                                        WidthRequest="24" HeightRequest="24"
                                        BackgroundColor="{AppThemeBinding Light=#FFE8CC, Dark=#4A3015}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="!"
                                           FontSize="18" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#A95517, Dark=#FFD18E}"
                                           VerticalTextAlignment="Center"
                                           HorizontalTextAlignment="Center" />
                                </Border>
                                <Label x:Name="AllergyLabel"
                                       FontSize="13.5"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#A95517, Dark=#FFD18E}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Read Summary"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="48"
                            BackgroundColor="#D9472B"
                            TextColor="#FFFFFF"
                            Clicked="OnSpeakClicked"
                            SemanticProperties.Hint="Read the nutrition summary aloud" />
                    <Button Grid.Column="1"
                            Text="Stop Reading"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFA, Dark=#1A1712}"
                            BorderColor="{AppThemeBinding Light=#F0D6B8, Dark=#3E3023}"
                            BorderWidth="1.2"
                            TextColor="{AppThemeBinding Light=#D9472B, Dark=#FFB15D}"
                            Clicked="OnStopSpeechClicked"
                            SemanticProperties.Hint="Stop the current speech" />
                </Grid>

                <Button Text="Vibration Reminder"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48"
                        BackgroundColor="#2E7A4F"
                        TextColor="#FFFFFF"
                        Clicked="OnVibrateClicked"
                        SemanticProperties.Hint="Use mobile vibration as a meal reminder" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
