<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0A0F1A}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <Grid RowDefinitions="Auto,*">
            <Border StrokeThickness="0" Grid.Row="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,28,28" />
                </Border.StrokeShape>
                <Grid BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}"
                      IsClippedToBounds="True"
                      HeightRequest="360">
                    <Image Source="{Binding ImageUrl}"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Large food photo"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                    <Border StrokeThickness="0" HeightRequest="160" HorizontalOptions="Fill" VerticalOptions="End">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#CC000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Padding="20,18" VerticalOptions="End">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="NameLabel"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF"
                                       SemanticProperties.HeadingLevel="Level1" />
                                <Label x:Name="CategoryLabel"
                                       FontSize="14"
                                       TextColor="#FCD34D" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#FBBF24"
                                    Padding="14,9"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label x:Name="CaloriesLabel"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1" Padding="20,16" Spacing="16">

                <Border StrokeThickness="1.2"
                        Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Label Text="Nutrition breakdown"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A5F}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Protein}"
                                           TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#60A5FA, Dark=#A8C8FF}"
                                           Text="Protein (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#3A2A10}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Carbs}"
                                           TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#D97706, Dark=#FDE68A}"
                                           Text="Carbs (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#3A1012}" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label FontSize="22" FontAttributes="Bold"
                                           Text="{Binding Fat}"
                                           TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}" HorizontalTextAlignment="Center" />
                                    <Label FontSize="11" TextColor="{AppThemeBinding Light=#EF4444, Dark=#FCA5A5}"
                                           Text="Fat (g)" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border StrokeThickness="1.2"
                        Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Padding="18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Label Text="About this item"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                        <Label x:Name="DescriptionLabel"
                               Grid.Row="1"
                               FontSize="14.5"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                        <Border Grid.Row="2"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#3A2A10}"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="AllergyLabel"
                                   FontSize="13.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Read Summary"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="48"
                            BackgroundColor="#2563EB"
                            TextColor="#FFFFFF"
                            Clicked="OnSpeakClicked"
                            SemanticProperties.Hint="Read the nutrition summary aloud" />
                    <Button Grid.Column="1"
                            Text="Stop Reading"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="48"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                            BorderColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                            BorderWidth="1.2"
                            TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                            Clicked="OnStopSpeechClicked"
                            SemanticProperties.Hint="Stop the current speech" />
                </Grid>

                <Button Text="Vibration Reminder"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48"
                        BackgroundColor="#FBBF24"
                        TextColor="#1E293B"
                        Clicked="OnVibrateClicked"
                        SemanticProperties.Hint="Use mobile vibration as a meal reminder" />

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
