<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo">
    <ScrollView>
        <ScrollView.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0A0F1A}" Offset="1.0" />
            </LinearGradientBrush>
        </ScrollView.Background>

        <VerticalStackLayout Padding="20" Spacing="16">

            <Border StrokeThickness="0" Padding="20,18" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#18000000" Offset="0,6" Radius="14" Opacity="0.3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile hardware"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Camera, location, speech, vibration, and haptic feedback."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1.2"
                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Camera"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <Label Text="Capture or pick a meal photo."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Gallery"
                                Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                                TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                BorderColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                BorderWidth="1.2"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="12"
                                Clicked="OnPickPhotoClicked"
                                SemanticProperties.Hint="Pick a food image from the gallery" />
                        <Button Grid.Column="2"
                                Text="Camera"
                                Padding="12,0"
                                BackgroundColor="#2563EB"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="12"
                                Clicked="OnTakePhotoClicked"
                                SemanticProperties.Hint="Open the camera to capture a food image" />
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#0F172A}"
                            HeightRequest="200">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Image x:Name="FoodPhoto"
                               Aspect="AspectFill"
                               SemanticProperties.Description="Captured food photo preview" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1.2"
                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E3A5F}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#15000000" Offset="0,4" Radius="10" Opacity="0.25" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Location"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                            <Label Text="Country, city, region, and coordinates."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Locate"
                                Padding="16,0"
                                BackgroundColor="#FBBF24"
                                TextColor="#1E293B"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="12"
                                Clicked="OnGetLocationClicked"
                                SemanticProperties.Hint="Use location to record the meal place" />
                    </Grid>
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A5F}"
                            Padding="14,11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label x:Name="LocationLabel"
                               Text="Location has not been captured yet."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />
                    </Border>
                    <Label x:Name="CoordinateLabel"
                           Text="Coordinates will appear here."
                           FontSize="12.5"
                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read Help"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48"
                        BackgroundColor="#FBBF24"
                        TextColor="#1E293B"
                        Clicked="OnReadHelpClicked"
                        SemanticProperties.Hint="Read the help text aloud" />
                <Button Grid.Column="1"
                        Text="Stop Speech"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        BorderColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                        BorderWidth="1.2"
                        TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Hint="Stop current speech" />
            </Grid>

            <Button Text="Haptic Feedback Test"
                    FontAttributes="Bold"
                    FontSize="14"
                    CornerRadius="14"
                    HeightRequest="48"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    BorderColor="{AppThemeBinding Light=#FBBF24, Dark=#FBBF24}"
                    BorderWidth="1.5"
                    TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}"
                    Clicked="OnFeedbackClicked"
                    SemanticProperties.Hint="Trigger vibration and haptic feedback" />

            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FEF9E7, Dark=#3A2A10}"
                    Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready."
                           FontAttributes="Bold"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
